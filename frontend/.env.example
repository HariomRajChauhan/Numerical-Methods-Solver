# Frontend build/runtime configuration (read by Vite at dev time and build time).
# Empty value = same-origin: in dev the Vite proxy (vite.config.ts) forwards
# /api to the FastAPI backend, and in production nginx does the same. This
# avoids CORS entirely. Set a full URL only to point at a remote backend.
#
# Cloudflare Workers production build:
# VITE_API_BASE_URL=https://numerical-methods-solver-api.onrender.com
# The client appends /api/health, so the final URL is:
# https://numerical-methods-solver-api.onrender.com/api/health
VITE_API_BASE_URL=
